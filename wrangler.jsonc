{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rajana-car-rental",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.rajanacarrental.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
